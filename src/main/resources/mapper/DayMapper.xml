<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.cxdproject.coder.mapper.DayMapper">

    <resultMap id="BaseResultMap" type="cn.cxdproject.coder.model.entity.Day">
        <id column="id" property="id" />
        <result column="tour_id" property="tourId" />
        <result column="name" property="name" />
        <result column="day" property="day" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
        <result column="deleted" property="deleted" />
    </resultMap>

    <sql id="Base_Column_List">
        `id`,
        `tour_id`,
        `name`,
        `day`,
        `created_at`,
        `updated_at`,
        `deleted`
    </sql>

    <!-- 根据 tour_id 查询所有 Day（未删除） -->
    <select id="selectByTourId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM fi_days
        WHERE tour_id = #{tourId}
        AND deleted = 0
        ORDER BY day ASC
    </select>

    <!-- 根据 tour_id 批量逻辑删除 -->
    <update id="logicDeleteByTourId">
        UPDATE fi_days
        SET deleted = 1,
            updated_at = NOW()
        WHERE tour_id = #{tourId}
        AND deleted = 0
    </update>

</mapper>
