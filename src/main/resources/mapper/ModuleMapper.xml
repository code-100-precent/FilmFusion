<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.cxdproject.coder.mapper.ModuleMapper">

    <resultMap id="BaseResultMap" type="cn.cxdproject.coder.model.entity.Module">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="description" property="description" />
        <result column="deleted" property="deleted" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <sql id="Base_Column_List">
        `id`,
        `name`,
        `description`,
        `deleted`,
        `created_at`,
        `updated_at`
    </sql>

    <select id="selectIds" resultType="long">
        SELECT id
        FROM fi_module
        <where>
            deleted = 0
            <if test="keyword != null and keyword != ''">
                AND (
                name LIKE CONCAT('%', #{keyword}, '%')
                OR description LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
            <if test="lastId != null">
                AND id > #{lastId}
            </if>
        </where>
        ORDER BY created_at DESC
        LIMIT #{size}
    </select>

    <select id="getAdminPage" resultType="cn.cxdproject.coder.model.entity.Module">
        SELECT *
        FROM fi_module
        WHERE deleted = 0
        <if test="keyword != null and keyword != ''">
            AND (
            name LIKE CONCAT('%', #{keyword}, '%')
            OR description LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>
        ORDER BY created_at DESC
        LIMIT #{offset}, #{size}
    </select>

    <update id="updateModule">
        UPDATE fi_module
        <set>
            <if test="dto.name != null">
                name = #{dto.name},
            </if>
            <if test="dto.description != null">
                description = #{dto.description},
            </if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
        AND deleted = 0
    </update>

    <select id="getTotal" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM fi_module
        WHERE deleted = 0
        <if test="keyword != null and keyword != ''">
            AND (
            name LIKE CONCAT('%', #{keyword}, '%')
            OR description LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>
    </select>

    <select id="selectAll" resultType="cn.cxdproject.coder.model.entity.Module">
        SELECT *
        FROM fi_module
        WHERE deleted = 0
        ORDER BY created_at DESC
    </select>
</mapper>
